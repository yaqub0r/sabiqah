---
const { text } = Astro.props as { text: string };
// Isolate retained Arabic phrases in English without changing released bytes.
const parts = text.split(/([\p{Script=Arabic}\p{Mark}]+(?:[\s\u200c\u200d]*[\p{Script=Arabic}\p{Mark}]+)*)/gu);
---
{parts.map((part, index) => index % 2 ? <bdi lang="ar" dir="rtl">{part}</bdi> : part)}
