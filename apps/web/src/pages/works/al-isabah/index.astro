---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { CorpusReader } from "../../../components/CorpusReader";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title="Al-Isabah fi Tamyiz al-Sahabah">
  <section class="shell">
    <p class="eyebrow">Working translation · transparent review</p>
    <div class="section-heading">
      <div>
        <h1>Al-Isabah fi Tamyiz al-Sahabah</h1>
        <p class="lede" lang="ar" dir="rtl">
          الإصابة في تمييز الصحابة
        </p>
      </div>
      <span class="badge warning">Public promotion blocked</span>
    </div>
    <p class="issue-banner">
      This page surfaces the work as it actually stands: translated,
      machine-checked, unresolved, and awaiting human review. It is not an
      approved scholarly release. The public inventory is safe to share;
      restricted text and intermediate evidence require reviewer access.
    </p>
    <CorpusReader client:load siteKey={siteKey} />
  </section>
</BaseLayout>
