---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { CorpusReader } from "../../../components/CorpusReader";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title="Al-Isabah fi Tamyiz al-Sahabah">
  <section class="shell">
    <p class="eyebrow">Working translation · transparent review</p>
    <div class="section-heading">
      <div>
        <h1>Al-Isabah fi Tamyiz al-Sahabah</h1>
        <p class="lede" lang="ar" dir="rtl">
          الإصابة في تمييز الصحابة
        </p>
      </div>
      <span class="badge warning">Canonical promotion blocked</span>
    </div>
    <p class="issue-banner">
      This public working edition replaces restricted Arabic with a pinned,
      licensed source and excludes unapproved modern apparatus. Its English is
      machine-checked and still awaiting human scholarly review. Records that
      cannot yet pass the public-output checks remain explicitly quarantined;
      restricted comparison evidence is never shown here.
    </p>
    <p>
      Arabic source: <a
        href="https://github.com/OpenITI/0875AH/blob/5835c183b8bbf4ea454d5c1be2b168b669403771/data/0852IbnHajarCasqalani/0852IbnHajarCasqalani.IsabaFiTamyiz/0852IbnHajarCasqalani.IsabaFiTamyiz.JK000533-ara1.mARkdown"
        >OpenITI JK000533</a
      >, used under <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        >CC BY-NC-SA 4.0</a
      >. Sabiqah removes structural markup and modern paratext, applies the
      documented honorific typography, and pairs the result with its working
      English translation.
    </p>
    <CorpusReader client:load siteKey={siteKey} />
  </section>
</BaseLayout>
