---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { alIsabahRelease } from "../../../lib/release";
---

<BaseLayout title={alIsabahRelease.work.titleEn}>
  <section class="shell">
    <p class="eyebrow">Beta reader · synthetic fixtures</p>
    <div class="section-heading">
      <div>
        <h1>{alIsabahRelease.work.titleEn}</h1>
        <p class="lede" lang="ar" dir="rtl">{alIsabahRelease.work.titleAr}</p>
      </div>
      <span class="badge">Release {alIsabahRelease.release.id}</span>
    </div>
    <p class="issue-banner">
      These three records are interface fixtures, not publishable scholarship. They exercise normal,
      page-spanning, and disputed-source states before real release ingestion.
    </p>
    <ol class="entry-list">
      {alIsabahRelease.entries.map((entry) => (
        <li>
          <a class="entry-card" href={`/works/al-isabah/entry/${entry.id}/`}>
            <span class="entry-number">{entry.sequence}</span>
            <span>
              <h2>{entry.title.en}</h2>
              <p lang="ar" dir="rtl">{entry.title.ar}</p>
            </span>
            <span class:list={["badge", { warning: entry.issues.length > 0 }]}>
              {entry.issues.length > 0 ? "Needs attention" : "Ready to read"}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
