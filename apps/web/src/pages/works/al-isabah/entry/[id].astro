---
import type { GetStaticPaths } from "astro";
import type { BookEntry } from "@sabiqah/release-model";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { alIsabahRelease } from "../../../../lib/release";

export const getStaticPaths = (() =>
  alIsabahRelease.entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

interface Props { entry: BookEntry }
const { entry } = Astro.props;
---

<BaseLayout title={entry.title.en}>
  <article class="shell narrow">
    <p class="breadcrumb"><a href="/works/al-isabah/">Al-Isabah</a> / Entry {entry.sequence}</p>
    <header class="entry-title">
      <div><p class="eyebrow">Fixture entry {entry.sequence}</p><h1>{entry.title.en}</h1></div>
      <p class="arabic-title" lang="ar" dir="rtl">{entry.title.ar}</p>
    </header>
    {entry.issues.map((issue) => <aside class="issue-banner"><strong>{issue.severity}:</strong> {issue.summary}</aside>)}
    {entry.segments.map((segment) => (
      <section class="bilingual-segment" id={segment.id}>
        <div class="english-column" lang="en" dir="ltr">
          <p>{segment.english.text || "Translation not yet available."}</p>
          <p class="segment-meta"><span>English: {segment.english.reviewState}</span></p>
        </div>
        <div class="arabic-column" lang="ar" dir="rtl">
          <p class="arabic">{segment.arabic.text}</p>
          <p class="segment-meta"><span>Arabic: {segment.arabic.reviewState}</span></p>
        </div>
      </section>
    ))}
    <div class="actions">
      <a class="button" href={`/admin/al-isabah/${entry.id}/`}>Review this entry</a>
      <a class="button secondary" href="/works/al-isabah/">Back to entries</a>
    </div>
    <section class="source-list">
      <h2>Source record</h2>
      <ul>{entry.sourceSpans.map((span) => <li>{span.editionId}, vol. {span.volume}, p. {span.pageStart}{span.pageEnd ? `–${span.pageEnd}` : ""}</li>)}</ul>
    </section>
  </article>
</BaseLayout>
