---
import type { GetStaticPaths } from "astro";
import type { BookEntry } from "@sabiqah/release-model";
import { ReviewerGate } from "../../../components/ReviewerGate";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { alIsabahRelease } from "../../../lib/release";

export const getStaticPaths = (() =>
  alIsabahRelease.entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

interface Props { entry: BookEntry }
const { entry } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title={`Review ${entry.title.en}`}>
  <section class="shell narrow">
    <p class="breadcrumb"><a href={`/works/al-isabah/entry/${entry.id}/`}>← Return to entry</a></p>
    <ReviewerGate
      siteKey={siteKey}
      returnTo={Astro.url.pathname}
      bookSlug={alIsabahRelease.work.slug}
      releaseId={alIsabahRelease.release.id}
      entry={entry}
      client:load
    />
  </section>
</BaseLayout>
