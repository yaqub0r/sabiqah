---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Open scholarly reading">
  <section class="shell hero">
    <div>
      <p class="eyebrow">Source-grounded · bilingual · open review</p>
      <h1>Read with the record in view.</h1>
      <p class="lede">
        Sabiqah pairs Arabic sources with careful English translation, visible uncertainty, and a
        review path that sends every proposed change back to the book's own repository.
      </p>
      <div class="actions">
        <a class="button" href="/works/al-isabah/">Explore Al-Isabah</a>
        <a class="button secondary" href="/about/">How review works</a>
      </div>
    </div>
    <aside class="arabic-card" aria-label="Arabic project mark">
      <span lang="ar" dir="rtl">سابقة</span>
      <p>A beginning that preserves what came before it.</p>
    </aside>
  </section>
</BaseLayout>
